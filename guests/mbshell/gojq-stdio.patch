diff -ruN orig/cli/stdio.go gojq/cli/stdio.go
--- orig/cli/stdio.go	1970-01-01 00:00:00
+++ gojq/cli/stdio.go	2026-09-28 00:00:00
@@ -0,0 +1,12 @@
+package cli
+
+import "io"
+
+// RunWith runs gojq on the given streams and arguments (without the program name).
+func RunWith(in io.Reader, out, err io.Writer, args []string) int {
+	return (&cli{
+		inStream:  in,
+		outStream: out,
+		errStream: err,
+	}).run(args)
+}
