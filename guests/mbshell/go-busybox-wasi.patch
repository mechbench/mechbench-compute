+
+// Run under wasm runs COMMAND in-process through core.RunCommand and
+// returns its status. DURATION is parsed for validity and then NOT
+// enforced: there is no process to signal and a goroutine cannot be
+// preempted, so the sandbox's own wall-clock cap is the only clock.
+// (mechbench seam)
 func Run(stdio *core.Stdio, args []string) int {
-	stdio.Errorf("timeout: not supported in wasm\n")
-	return core.ExitFailure
+	i := 0
+	for i < len(args) && strings.HasPrefix(args[i], "-") {
+		switch args[i] {
+		case "-s", "--signal", "-k", "--kill-after":
+			i += 2
+		default:
+			i++
+		}
+	}
+	if len(args)-i < 2 {
+		return core.UsageError(stdio, "timeout", "missing duration or command")
+	}
+	if _, err := timeutil.ParseDuration(args[i]); err != nil {
+		return core.UsageError(stdio, "timeout", "invalid duration")
+	}
+	if core.RunCommand == nil {
+		stdio.Errorf("timeout: not supported in wasm\n")
+		return core.ExitFailure
+	}
+	code, found := core.RunCommand(stdio, args[i+1], args[i+2:])
+	if !found {
+		stdio.Errorf("timeout: %s: not found\n", args[i+1])
+		return 127
+	}
+	return code
 }
