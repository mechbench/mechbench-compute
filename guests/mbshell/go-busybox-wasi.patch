+
+// Run under wasm runs COMMAND in-process through core.RunCommand and
+// reports real elapsed time from the host's clock — which, under a
+// strict sandbox, is a virtual one. (mechbench seam)
 func Run(stdio *core.Stdio, args []string) int {
-	stdio.Errorf("time: not supported in wasm\n")
-	return core.ExitFailure
+	if len(args) == 0 {
+		return core.UsageError(stdio, "time", "missing command")
+	}
+	if core.RunCommand == nil {
+		stdio.Errorf("time: not supported in wasm\n")
+		return core.ExitFailure
+	}
+	start := time.Now()
+	code, found := core.RunCommand(stdio, args[0], args[1:])
+	elapsed := time.Since(start)
+	if !found {
+		stdio.Errorf("time: %s: not found\n", args[0])
+		return 127
+	}
+	sec := elapsed.Seconds()
+	spec := timeutil.DurationSpec{Duration: elapsed, Unit: "s", Value: sec}
+	stdio.Errorf("real\t%s\n", timeutil.FormatDuration(spec))
+	stdio.Errorf("user\t0.00\n")
+	stdio.Errorf("sys\t0.00\n")
+	return code
 }
