# Provider API keys for scripts/check_provider_models.py.
# Copy this file to .env (which git ignores) and fill in the keys you have;
# a provider whose key is empty is skipped. A variable already set in the
# shell wins over this file.
#
# The check only lists each provider's models (GET on its models endpoint);
# it makes no model calls and spends nothing.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
